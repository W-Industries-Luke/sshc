# Maintainer: Luke A. Weaver <172839406+W-Industries-Luke@users.noreply.github.com>
#
# The Arch User Repository package "sshc-bin". To publish it, an AUR account
# is needed: clone ssh://aur@aur.archlinux.org/sshc-bin.git, copy this file in,
# run "updpkgsums && makepkg --printsrcinfo > .SRCINFO", commit and push.
pkgname=sshc-bin
pkgver=0.7.0
pkgrel=1
pkgdesc="ssh, scp, sftp and rsync that answer the password prompt for you"
arch=('x86_64' 'aarch64')
url="https://github.com/W-Industries-Luke/sshc"
license=('MIT')
depends=('openssh')
optdepends=('libsecret: keep secrets in the system keyring'
            'rsync: for "sshc rsync"')
provides=('sshc')
conflicts=('sshc')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/W-Industries-Luke/sshc/v$pkgver/LICENSE"
        "sshc-$pkgver.1::https://raw.githubusercontent.com/W-Industries-Luke/sshc/v$pkgver/docs/sshc.1")
source_x86_64=("sshc-$pkgver-x86_64::https://github.com/W-Industries-Luke/sshc/releases/download/v$pkgver/sshc-linux-amd64")
source_aarch64=("sshc-$pkgver-aarch64::https://github.com/W-Industries-Luke/sshc/releases/download/v$pkgver/sshc-linux-arm64")
sha256sums=('SKIP' 'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "sshc-$pkgver-$CARCH" "$pkgdir/usr/bin/sshc"
  install -Dm644 "sshc-$pkgver.1" "$pkgdir/usr/share/man/man1/sshc.1"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
